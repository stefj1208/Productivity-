<?xml version="1.0" encoding="utf-8"?>
<!-- Widget « Ma journée ». RemoteViews : seules les vues simples sont permises. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/w_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#FFB8B8C4"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/w_priority"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="#FFF4F4F8"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/w_next"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#FFD8D8E0"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/w_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#FFB8B8C4"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/w_meal"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/widget_button_bg"
            android:gravity="center"
            android:text="📷 Repas"
            android:textColor="#FFF4F4F8"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/w_capture"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/widget_button_bg"
            android:gravity="center"
            android:text="＋ Noter"
            android:textColor="#FFF4F4F8"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/w_focus"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/widget_button_bg"
            android:gravity="center"
            android:text="🎧 Focus"
            android:textColor="#FFF4F4F8"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
